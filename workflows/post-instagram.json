      "parameters": {
        "jsCode": "const item = $input.first();\nconst arquivo = Object.values(item.binary ?? {})[0];\nif (!arquivo) throw new Error('Nenhuma imagem recebida.');\nif (arquivo.mimeType !== 'image/jpeg') throw new Error('Envie uma imagem JPEG.');\nconst legenda = item.json.legenda ?? item.json.Legenda ?? '';\nreturn [{ json: { arquivo: arquivo.fileName, legenda }, binary: { imagem: arquivo } }];"
      },
